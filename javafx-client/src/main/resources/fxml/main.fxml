<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            styleClass="app-root"
            fx:controller="com.lcorp.javafx.controller.MainController">
    <!-- Верхняя часть окна: название экрана -->
    <top>
        <VBox spacing="10" styleClass="toolbar">
            <BorderPane.margin>
                <Insets top="16" right="16" bottom="12" left="16" />
            </BorderPane.margin>
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="Заявки на перевозку" styleClass="page-title" />
                <Button fx:id="createButton" text="Добавить заявку"
                        disable="true" onAction="#onCreateRequest" styleClass="primary" />
                <Button fx:id="editButton" text="Редактировать"
                        disable="true" onAction="#onEditRequest" />
                <Button fx:id="deleteButton" text="Удалить"
                        disable="true" onAction="#onDeleteRequest" styleClass="danger" />
                <Button fx:id="statisticsButton" text="Статистика"
                        disable="true" onAction="#onShowStatistics" />
                <Button fx:id="exportButton" text="Экспорт CSV"
                        disable="true" onAction="#onExportCsv" />
            </HBox>
            <HBox fx:id="searchBox" alignment="CENTER_LEFT" spacing="8" disable="true">
                <Label text="Поиск:" />
                <TextField fx:id="searchField" prefWidth="300"
                           promptText="Груз, адрес или клиент" onAction="#onSearch" />
                <Button text="Применить" onAction="#onSearch" />
                <Button text="Сбросить" onAction="#onClearSearch" />
            </HBox>
            <HBox fx:id="filterBox" alignment="CENTER_LEFT" spacing="8" disable="true">
                <Label text="Статус:" />
                <ComboBox fx:id="statusBox" prefWidth="145" promptText="Все" />
                <Label text="Клиент:" />
                <ComboBox fx:id="clientBox" prefWidth="205" promptText="Все" />
                <Label text="Сортировка:" />
                <ComboBox fx:id="sortFieldBox" prefWidth="145" />
                <ComboBox fx:id="sortDirectionBox" prefWidth="155" />
            </HBox>
        </VBox>
    </top>

    <!-- Контроллер заполняет таблицу данными из PostgreSQL. -->
    <center>
        <TableView fx:id="requestTable">
            <BorderPane.margin>
                <Insets right="16" bottom="16" left="16" />
            </BorderPane.margin>
            <columns>
                <TableColumn fx:id="idColumn" text="№" prefWidth="60" />
                <TableColumn fx:id="cargoColumn" text="Груз" prefWidth="160" />
                <TableColumn fx:id="weightColumn" text="Вес, кг" prefWidth="90" />
                <TableColumn fx:id="statusColumn" text="Статус" prefWidth="110" />
                <TableColumn fx:id="pickupColumn" text="Откуда" prefWidth="160" />
                <TableColumn fx:id="deliveryColumn" text="Куда" prefWidth="160" />
            </columns>
            <placeholder>
                <Label text="Данные пока не подключены" />
            </placeholder>
        </TableView>
    </center>
</BorderPane>
