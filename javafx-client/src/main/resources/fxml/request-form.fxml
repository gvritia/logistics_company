<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.lcorp.javafx.controller.RequestFormController" fitToWidth="true" hbarPolicy="NEVER">
    <content>
        <VBox spacing="12" styleClass="form-page">
            <Label text="Данные заявки" styleClass="page-title" />
            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="160" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>
                <Label text="Клиент *" GridPane.rowIndex="0" />
                <ComboBox fx:id="clientBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Оператор *" GridPane.rowIndex="1" />
                <ComboBox fx:id="operatorBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Груз *" GridPane.rowIndex="2" />
                <TextArea fx:id="cargoField" prefRowCount="2" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="Вес, кг *" GridPane.rowIndex="3" />
                <TextField fx:id="weightField" promptText="Например, 125.500" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label text="Цена *" GridPane.rowIndex="4" />
                <TextField fx:id="priceField" promptText="Например, 15000.00" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                <Label text="Адрес отправления *" GridPane.rowIndex="5" />
                <TextField fx:id="pickupField" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                <Label text="Адрес доставки *" GridPane.rowIndex="6" />
                <TextField fx:id="deliveryField" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                <Label text="Дата доставки *" GridPane.rowIndex="7" />
                <DatePicker fx:id="plannedDate" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                <Label text="Время доставки *" GridPane.rowIndex="8" />
                <TextField fx:id="plannedTime" promptText="ЧЧ:ММ" GridPane.columnIndex="1" GridPane.rowIndex="8" />
            </GridPane>
            <Label fx:id="errorLabel" wrapText="true" styleClass="error-label" />
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Button text="Отмена" onAction="#cancel" />
                <Button text="Сохранить" onAction="#save" styleClass="primary-button" />
            </HBox>
        </VBox>
    </content>
</ScrollPane>
