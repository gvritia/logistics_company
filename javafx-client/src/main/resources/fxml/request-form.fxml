<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>

<GridPane xmlns:fx="http://javafx.com/fxml"
          fx:controller="com.lcorp.javafx.controller.RequestFormController"
          hgap="12" vgap="10">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16" />
    </padding>
    <columnConstraints>
        <ColumnConstraints minWidth="145" />
        <ColumnConstraints minWidth="300" />
    </columnConstraints>

    <Label text="Клиент" GridPane.rowIndex="0" />
    <ComboBox fx:id="clientBox" promptText="Выберите клиента"
              maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />

    <Label text="Оператор" GridPane.rowIndex="1" />
    <ComboBox fx:id="operatorBox" promptText="Выберите оператора"
              maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

    <Label text="Описание груза" GridPane.rowIndex="2" />
    <TextField fx:id="cargoField" promptText="Например, офисная мебель"
               GridPane.columnIndex="1" GridPane.rowIndex="2" />

    <Label text="Вес, кг" GridPane.rowIndex="3" />
    <TextField fx:id="weightField" promptText="Например, 125.5"
               GridPane.columnIndex="1" GridPane.rowIndex="3" />

    <Label text="Стоимость, ₽" GridPane.rowIndex="4" />
    <TextField fx:id="priceField" promptText="Например, 15000.00"
               GridPane.columnIndex="1" GridPane.rowIndex="4" />

    <Label text="Плановая дата доставки" GridPane.rowIndex="5" />
    <DatePicker fx:id="deliveryDatePicker" maxWidth="Infinity"
                GridPane.columnIndex="1" GridPane.rowIndex="5" />

    <Label text="Адрес отправления" GridPane.rowIndex="6" />
    <TextField fx:id="pickupField" GridPane.columnIndex="1" GridPane.rowIndex="6" />

    <Label text="Адрес доставки" GridPane.rowIndex="7" />
    <TextField fx:id="deliveryField" GridPane.columnIndex="1" GridPane.rowIndex="7" />
</GridPane>
